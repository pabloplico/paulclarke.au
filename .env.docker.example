# ==========================================
# Docker Environment Configuration
# Copy this file to .env.docker and fill in your values
# ==========================================

# ==========================================
# Infrastructure
# ==========================================
POSTGRES_USER=business_portal
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=business_portal

# Redis password (required in production)
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# Database, queue and rate-limit drivers (admin-portal). The defaults are this
# Docker setup. The single-instance demo uses pglite + memory: no Postgres or
# Redis at all.
# DB_DRIVER=postgres          # postgres | pglite
# QUEUE_DRIVER=bullmq         # bullmq | memory
# RATE_LIMIT_DRIVER=memory    # memory | redis (redis needs QUEUE_DRIVER=bullmq)
# PGLITE_DATA_DIR=            # pglite only; unset means in memory
# PGLITE_SNAPSHOT=            # pglite only; dumpDataDir() tarball to seed a new database
# UPLOADS_DIR=                # uploaded files; default ./uploads in the app's working directory

# ==========================================
# AI API Keys (Server-side only)
# ==========================================
# admin-portal receives this as OPENAI_API_KEY (also used for embeddings)
ADMIN_PORTAL_OPENAI_API_KEY=your_admin_portal_openai_api_key
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# AI Provider Configuration (admin-portal)
# ==========================================
# 'anthropic' (default), 'openai', 'gemini', 'ollama' or 'ollama-remote'.
# AI_MODEL must belong to AI_PROVIDER (claude-* for anthropic, gpt-* for
# openai, gemini-* for gemini), and the provider's key must be set above.
# The app checks this at start-up: a warning in development, fatal in
# production and demo mode. Embeddings always use OpenAI, so
# ADMIN_PORTAL_OPENAI_API_KEY is needed whatever the chat provider.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# AI cost controls (all optional outside demo mode)
# AI_MAX_OUTPUT_TOKENS=4096      # cap on every call's output
# AI_DAILY_BUDGET_USD=           # total spend per Brisbane day; demo default 2
# AI_USER_DAILY_BUDGET_USD=      # per user per day; demo default 0.25
# AI_USER_REQUESTS=30            # AI requests per user per window
# AI_USER_WINDOW_MINUTES=10

# ==========================================
# Admin account (pnpm db:seed-admin)
# ==========================================
# Required; there is no default admin. Without ADMIN_PASSWORD a random
# password is generated and printed once.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# ==========================================
# Demo mode (admin-portal public demo; leave unset for development)
# ==========================================
# DEMO_MODE=true switches off the features listed in lib/demo.ts and makes
# Cloudflare Access the only way in. It needs AI_PROVIDER=openai, an AI_MODEL
# with a price in lib/ai/pricing.ts, and these two from the Access application:
# DEMO_MODE=true
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<application AUD tag>
# Local only: stand in for Access as this email. Refused when NODE_ENV=production.
# DEV_ACCESS_IDENTITY=you@example.com
# The demo's own OpenAI key (a separate OpenAI project with its own monthly
# budget), kept apart from ADMIN_PORTAL_OPENAI_API_KEY. Nothing reads it yet:
# the demo container run (coming with the demo seed) passes it to the app as
# OPENAI_API_KEY, and on Cloud Run it comes from Secret Manager instead.
# DEMO_OPENAI_API_KEY=

# ==========================================
# Ollama
# ==========================================
# Ollama URLs for admin-portal AI provider
# Local: Docker host gateway IP (typically 172.17.0.1 or 172.18.0.1)
OLLAMA_URL=http://host.docker.internal:11434
# Remote: e.g. another machine on your network
OLLAMA_REMOTE_URL=http://your_remote_host:11434

# ==========================================
# Application-specific
# ==========================================
# Blog API base URL (apps/website) used by the admin-portal content audit (default: http://localhost:3000)
BUSINESS_PORTAL_URL=http://localhost:3000

# LAN hosts (IP or hostname) allowed to load the admin-portal dev server, comma-separated
# ALLOWED_DEV_ORIGINS=192.168.1.20,192.168.1.21

# Set to 'false' to disable admin-portal auth (dev convenience)
AUTH_ENABLED=true
AUTH_SECRET=your_auth_secret_at_least_32_chars

# ==========================================
# Website (apps/website) — Cloudflare Workers, no secrets required.
# Contact uses mailto:, assessment downloads as PDF.
# ==========================================

# ==========================================
# External API Services (admin-portal client lookup)
# ==========================================
# ABN Lookup GUID — register at abr.business.gov.au
ABN_LOOKUP_GUID=your_abn_lookup_guid
# Brave Search API key — brave.com/search/api
BRAVE_SEARCH_API=your_brave_search_api_key
# GOOGLE_API_KEY above is also used for Google Places autocomplete
# NewsAPI key for the research agents' news tool — newsapi.org
# NEWSAPI_KEY=
