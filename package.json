{
  "name": "paulclarke.au",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint lint:root",
    "lint:fix": "biome check --write --unsafe . && nx run-many -t lint",
    "format": "biome format --write . && prettier --write \"**/*.{md,svelte}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,svelte}\"",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t test:e2e",
    "test:diff": "bash scripts/test-diff-summary.sh",
    "check-types": "nx run-many -t check-types",
    "lint:root": "biome check *.json .claude"
  },
  "nx": {
    "includedScripts": [
      "lint:root"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@repo/prettier-config": "workspace:*",
    "nx": "23.3.0",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp",
      "workerd"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [],
      "allowedVersions": {
        "@opentelemetry/sdk-logs": ">=0.200.0",
        "@opentelemetry/resources": ">=2.0.0",
        "@opentelemetry/sdk-metrics": ">=2.0.0",
        "@opentelemetry/sdk-trace-base": ">=2.0.0",
        "@opentelemetry/instrumentation": ">=0.200.0"
      }
    }
  }
}
