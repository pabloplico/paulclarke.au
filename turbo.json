{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "biome.json", "biome.jsonc"]
    },
    "//#lint:root": {
      "inputs": ["*.json", ".claude/**"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "dependsOn": ["^format:check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prettier.config.*",
        ".prettierrc*",
        "biome.json",
        "biome.jsonc",
        "../../packages/prettier-config/**",
        "../../packages/biome-config/**"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.*.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "**/*.test.tsx"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
