.env
.env.*
!.env.example
!.env.docker.example
.dev.vars
!.dev.vars.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test & coverage
coverage/
test-results/
playwright-report/

# Uploads
uploads/

# Deployment
.vercel/
.wrangler/

# Generated source files
**/server/posts.generated.ts

# Docker volumes
docker/data/

# Playwright MCP screenshots
.playwright-mcp/

# Database backups from the full-stack version (root only); kept so old dumps are never committed
/backups/

# Firebase service account keys
*-firebase-adminsdk-*.json

# Nx
.nx/cache
.nx/workspace-data
.nx/migrate-runs

# Local PGlite database and uploads for admin-portal dev:lite
.pglite/

# Next.js 16.4+ writes this when `next dev` runs under an AI coding agent
# (managed agent rules). Not committed: CLAUDE.md is the repo's agent guide
/apps/admin-portal/AGENTS.md

# Local-only notes kept beside the tracked docs (e.g. docs/audit/role-fit.local.md)
*.local.md
