{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobquest",
  "main": "server/index.ts",
  "compatibility_date": "2026-04-01",
  // No *.workers.dev or preview URLs: the only way in is the custom domain, which
  // Cloudflare Access covers. wrangler deploy attaches it (and creates its DNS record)
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "jobquest.paulclarke.au", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Deep links get index.html and Vue Router takes over; /api/* always runs the Worker
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobquest",
      "database_id": "12e7d8e4-fc3b-4e18-835a-7bebdf043aa0",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 3006
  },
  "vars": {
    "ENVIRONMENT": "production",
    // The Access team and application whose JWTs the Worker accepts (not secrets: the
    // AUD tag only says which application a token is for)
    "CF_ACCESS_TEAM_DOMAIN": "paulclarke.cloudflareaccess.com",
    "CF_ACCESS_AUD": "abe72949b50fcb832cf02090747001d3dc24ccb02b5951dac24ee7f0e2f1101e"
  }
}
