    "@repo/ui": "workspace:*",
    "ai": "catalog:",
    "bcryptjs": "^3.0.3",
    "clsx": "catalog:",
    "csv-parse": "^7.0.3",
    "diff": "catalog:",
    "drizzle-orm": "catalog:",
