    "js-tiktoken": "^1.0.21",
    "lucide-react": "catalog:",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "papaparse": "^5.7.0",
    "pdf-parse": "^1.1.4",
    "playwright": "catalog:",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "catalog:",
