{
  "name": "admin-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:lite",
    "build": "next build && node scripts/prune-standalone.mjs",
    "start": "next start --port 3001",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check-types": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed-admin": "tsx scripts/seed-admin-user.ts",
    "db:check-fresh": "tsx scripts/db/check-fresh-db.ts",
    "db:mark-baseline": "tsx scripts/db/mark-baseline-applied.ts",
    "dev:lite": "tsx scripts/dev-lite.ts",
    "dev:full": "tsx scripts/with-dev-env.ts next dev --port 3001 --hostname ${DEV_HOST:-127.0.0.1}",
    "with-dev-env": "tsx scripts/with-dev-env.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "demo:build-seed": "tsx scripts/demo/build-seed.ts",
    "dev:demo": "tsx scripts/dev-demo.ts"
  },
