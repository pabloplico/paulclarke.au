{
  "name": "website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild:posts": "node scripts/build-posts.mjs",
    "dev": "pnpm prebuild:posts && concurrently -n vite,worker -c cyan,green \"vite --host=0.0.0.0\" \"wrangler dev --ip 0.0.0.0\"",
    "build": "vite build",
    "deploy": "nx run website:build && wrangler deploy",
    "deploy:dry-run": "nx run website:build && wrangler deploy --dry-run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.3",
    "@repo/tailwind-theme": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "hono": "^4.7.10",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^9.1.0",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "jsdom": "^30.1.2",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.2.0",
    "vitest": "catalog:",
    "wrangler": "^4.0.0"
  }
}
