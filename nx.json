{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "analytics": false,
  "namedInputs": {
    "sharedGlobals": [{ "runtime": "node --version" }],
    "default": ["{projectRoot}/**/*", "!{projectRoot}/next-env.d.ts", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/playwright.config.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/biome.json"
    ],
    "biome": [
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/packages/biome-config/base.json",
      { "externalDependencies": ["@biomejs/biome"] }
    ]
  },
  "targetDefaults": {
    "prebuild:posts": {
      "cache": true,
      "inputs": [
        "{projectRoot}/content/posts/**/*",
        "{projectRoot}/scripts/build-posts.mjs",
        "sharedGlobals"
      ],
      "outputs": ["{projectRoot}/server/posts.generated.ts"]
    },
    "build": [
      {
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production"],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.next/!(cache)/**/*",
          "{projectRoot}/.next/!(cache)"
        ]
      },
      {
        "filter": { "projects": ["website"] },
        "cache": true,
        "dependsOn": ["^build", "prebuild:posts"],
        "inputs": ["production", "^production"],
        "outputs": ["{projectRoot}/dist"]
      }
    ],
    "check-types": [
      {
        "cache": true,
        "dependsOn": ["^check-types"],
        "inputs": ["default", "^production"]
      },
      {
        "filter": { "projects": ["website"] },
        "cache": true,
        "dependsOn": ["^check-types", "prebuild:posts"],
        "inputs": ["default", "^production"]
      }
    ],
    "lint": {
      "cache": true,
      "dependsOn": ["^lint"],
      "inputs": ["default", "biome"]
    },
    "lint:root": {
      "cache": true,
      "inputs": ["{workspaceRoot}/*.json", "{workspaceRoot}/.claude/**/*", "biome"]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        { "env": "TEST_REDIS_URL" },
        { "env": "TEST_DATABASE_URL" },
        { "env": "FLOW_DRIVERS" }
      ]
    },
    "db:check-fresh": {
      "cache": true,
      "inputs": [
        "{projectRoot}/drizzle/**/*",
        "{projectRoot}/lib/db/schema/**/*",
        "{projectRoot}/scripts/db/**/*",
        "sharedGlobals"
      ]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "continuous": true
    }
  }
}
